<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Phase 2 voice spike (VOICE_SPEC §14). Release builds do not declare it.
             Exported so a test run can start it with `adb shell am start`, and
             guarded by DUMP, which the shell holds and ordinary apps cannot get:
             no other app can make it open the microphone. -->
        <activity android:name="com.fc.freer.call.spike.VoiceSpikeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
