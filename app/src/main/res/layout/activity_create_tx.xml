<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/main_background"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ScrollView for txContainer -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <!-- txContainer (7/9) -->
            <LinearLayout
                android:id="@+id/txContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- inputCardsContainer (3/7) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/container_outline"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/inputHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/add_cash_to_spend"
                        android:textColor="@color/field_name" />

                    <LinearLayout
                        android:id="@+id/inputCardsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:orientation="vertical">

                    </LinearLayout>

                    <TextView
                        android:id="@+id/totalInputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:textColor="@color/text"
                        android:textSize="12sp" />

                    <include
                        android:id="@+id/plusInputButton"
                        layout="@layout/layout_plus_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="-20dp"
                        android:layout_marginEnd="0dp"
                        android:layout_marginBottom="0dp" />


                </LinearLayout>


                <!-- outputCardsContainer (3/7) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/container_outline"
                    android:padding="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/outputHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pay_to"
                        android:textColor="@color/field_name"
                        android:layout_marginBottom="4dp" />

                    <LinearLayout
                        android:id="@+id/outputCardsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:minHeight="40dp">

                    </LinearLayout>

                    <TextView
                        android:id="@+id/totalAndFeeText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="start"
                        android:textColor="@color/text"
                        android:layout_marginBottom="16dp"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- opreturnContainer (1/8) -->
                <LinearLayout
                    android:id="@+id/opreturnContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1">

                    <include
                        android:id="@+id/opreturnInput"
                        layout="@layout/layout_text_input_with_scan"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                </LinearLayout>
                <!-- outputInputContainer - Direct output input -->
                <LinearLayout
                    android:id="@+id/outputInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/container_outline"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:padding="0dp"
                        android:text="@string/add_payee"
                        android:textColor="@color/field_name"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- FID Input -->
                    <include
                        android:id="@+id/outputFidInput"
                        layout="@layout/layout_key_input_with_people_and_scan"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="0dp"
                        android:ellipsize="middle"
                        android:maxLines="2" />

                    <!-- Amount Input and Add Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/outputAmountInput"
                            layout="@layout/layout_text_input_with_scan"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="3" />
                        <!-- Lock Days Input (for per-output CLTV) -->
                        <include
                            android:id="@+id/outputLockDaysInput"
                            layout="@layout/layout_number_input_plain"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="2"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/addOutputButton"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/rounded_textbox_background"
                            android:backgroundTint="@color/accent"
                            android:contentDescription="@string/add"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_plus"
                            app:tint="@android:color/white" />

                    </LinearLayout>


                    <!-- Max Amount Text and Plus Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="0dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/addFromList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/pay_to_list"
                            android:focusable="true"
                            android:padding="0dp"
                            android:src="@drawable/ic_list"
                            app:tint="@color/accent" />
                        <ImageView
                            android:id="@+id/importArrayButton"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="12dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="0dp"
                            android:src="@drawable/ic_array"
                            android:contentDescription="@string/import_send_to_array"
                            app:tint="@color/accent" />

                        <ImageView
                            android:id="@+id/lockTimeToggle"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="12dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/lock_time"
                            android:focusable="true"
                            android:padding="0dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/accent" />



                        <TextView
                            android:id="@+id/outputRestText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="end"
                            android:textColor="@color/accent" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- buttonContainer  -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/copyButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy" />

            <ImageButton
                android:id="@+id/importButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_import"
                android:contentDescription="@string/import_a" />

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear" />

            <ImageButton
                android:id="@+id/createButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/create" />
            
            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout> 