<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="8dp">

    <TextView
        android:id="@+id/menu_group_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/members"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_update_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_group"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_ask_symkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ask_symkey"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_request_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/request_history"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_leave_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/leave_group"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
