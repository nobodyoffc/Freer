<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Include common toolbar -->
    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FID Search Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Search Results Hint -->
            <TextView
                android:id="@+id/searchResultsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_results"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Search Results ScrollView -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/container_outline"
                android:layout_marginBottom="8dp"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Search Results Layout -->
                    <LinearLayout
                        android:id="@+id/searchResultsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- More Results Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/moreResultsHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hint"
                            android:textSize="12sp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/moreFidButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/more"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            android:layout_gravity="center_vertical"
                            style="@style/ButtonStyle" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <!-- FID Search Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp">

                <EditText
                    android:id="@+id/fidSearchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_fid_or_cidt"
                    android:inputType="text"
                    android:textColor="@color/text"
                    android:textColorHint="@color/hint"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input_view"
                    android:maxLines="1"
                    android:gravity="top|start"
                    android:paddingEnd="80dp"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:ellipsize="middle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/fidSearchEditText"
                    android:layout_alignEnd="@id/fidSearchEditText"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/clearFidButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_clear"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="fitCenter"
                        android:padding="4dp"
                        android:contentDescription="@string/clear" />

                    <ImageButton
                        android:id="@+id/searchButton"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_search"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:scaleType="fitCenter"
                        android:padding="4dp"
                        android:contentDescription="@string/search"
                        app:tint="@color/accent" />



                </LinearLayout>

            </RelativeLayout>

        </LinearLayout>

        <!-- Input Container -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <include
                android:id="@+id/titlesView"
                layout="@layout/layout_text_input_with_scan"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="8dp" />

            <include
                android:id="@+id/memoView"
                layout="@layout/layout_text_input_with_scan"
                android:layout_width="match_parent"
                android:layout_height="60dp" />

        </LinearLayout>

        <!-- Check Container -->
        <LinearLayout
            android:id="@+id/checkContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="0dp">

            <CheckBox
                android:id="@+id/seeStatementCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_statement"
                android:textColor="@color/text"
                android:layout_marginEnd="16dp" />

            <CheckBox
                android:id="@+id/seeWritingsCheckBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_writings"
                android:textColor="@color/text" />

        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear" />

            <ImageButton
                android:id="@+id/carveButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/carve" />

            <ImageButton
                android:id="@+id/saveButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_save"
                android:contentDescription="@string/save" />
            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>