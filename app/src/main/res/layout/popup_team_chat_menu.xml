<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="8dp">

    <TextView
        android:id="@+id/menu_start_meeting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/meeting_start"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_team_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/members"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_consensus_doc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/consensus_document"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_owner_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/owner_menu"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/menu_manager_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manager_menu"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/menu_ask_symkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ask_symkey"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <!-- The ledger of every key this device has given out or taken in (FIMP §9.7). Its own
         entry rather than something buried behind Members…: it is a scrolling table, and a
         menu entry is also more discoverable. -->
    <TextView
        android:id="@+id/menu_symkey_ledger"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/symkey_exchange"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_request_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/request_history"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_leave_team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/leave_team"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
