<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main Container -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <include
                android:id="@+id/opreturnInput"
                layout="@layout/layout_text_input_with_scan"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                />

            <!-- Add Payee Checkbox -->
            <CheckBox
                android:id="@+id/addPayeeCheckbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_payee"
                android:textColor="@color/text"
                android:textSize="16sp"
                android:layout_marginBottom="0dp" />

            <!-- Payee Container (hidden by default) -->
            <LinearLayout
                android:id="@+id/payeeContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Output Cards Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/container_outline"
                    android:backgroundTint="@color/background_light"
                    android:padding="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/outputHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/pay_to"
                        android:textColor="@color/hint" />

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxHeight="200dp"
                        android:background="@color/main_background">

                        <LinearLayout
                            android:id="@+id/outputCardsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@color/cash_card_dark_background"
                            android:minHeight="100dp">

                        </LinearLayout>
                    </ScrollView>
                </LinearLayout>

                <!-- Output Input Container -->
                <LinearLayout
                    android:id="@+id/outputInputContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/container_outline"
                    android:backgroundTint="@color/background_light"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/add_payee"
                        android:textColor="@color/field_name"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="0dp"
                        android:layout_marginBottom="0dp"/>

                    <!-- FID Input -->
                    <include
                        android:id="@+id/outputFidInput"
                        layout="@layout/layout_key_input_with_people_and_scan"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginBottom="0dp"
                        android:layout_marginTop="2dp"
                        android:maxLines="2"
                        android:ellipsize="middle" />

                    <!-- Amount Input and Add Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="0dp"
                        android:gravity="center_vertical">

                        <include
                            android:id="@+id/outputAmountInput"
                            layout="@layout/layout_text_input_with_scan"
                            android:layout_width="240dp"
                            android:layout_height="52dp"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/addOutputButton"
                            style="@style/ButtonStyle"
                            android:layout_width="40dp"
                            android:layout_height="wrap_content"
                            android:text="@string/add" />

                    </LinearLayout>

                    <!-- Max Amount Text and Plus Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="0dp">

                        <TextView
                            android:id="@+id/addFromList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="0dp"
                            android:text="@string/pay_to_list"
                            android:textColor="@color/accent"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/outputRestText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/primary"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="end" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear" />

            <ImageButton
                android:id="@+id/opReturnButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_record"
                android:contentDescription="@string/op_return" />

            <ImageButton
                android:id="@+id/copyButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy" />

            <ImageButton
                android:id="@+id/createButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/send" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
