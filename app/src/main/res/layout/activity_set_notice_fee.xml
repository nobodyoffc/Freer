<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <!-- Common toolbar -->
    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="NestedWeights" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/container_outline"
            android:padding="16dp"
            android:orientation="vertical">

            <!-- My Notice Fee Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_notice_fee"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/my_notice_fee_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:inputType="numberDecimal"
                    android:enabled="false"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_result_item"
                    android:hint="@string/enter_notice_fee"/>

                <Button
                    android:id="@+id/my_notice_fee_button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"
                    style="@style/ButtonStyle"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Max Paying Notice Fee Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/max_notice_fee_to_pay"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/max_paying_notice_fee_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:inputType="numberDecimal"
                    android:enabled="false"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:padding="12dp"
                    android:background="@drawable/bg_result_item"
                    android:hint="@string/enter_max_notice_fee"/>

                <Button
                    android:id="@+id/max_paying_notice_fee_button"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/reset"
                    style="@style/ButtonStyle"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Always Pay Back Notice Fee Section -->
            <CheckBox
                android:id="@+id/pay_back_notice_fee_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pay_back_notice_fee"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:padding="12dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/clear_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/clear" />
        <ImageButton
            android:id="@+id/ok_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_tick"
            android:contentDescription="@string/confirm" />
        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />


    </LinearLayout>

</LinearLayout>
