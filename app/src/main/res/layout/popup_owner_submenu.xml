<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="8dp">

    <TextView
        android:id="@+id/submenu_update_team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_team"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_appoint_manager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/appoint_manager"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_cancel_appointment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancel_appointment"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_transfer_team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/transfer_team"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_create_symkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_symkey"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_disband_team"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/disband_team"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
