<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/menu_item_background"
    android:padding="8dp"
    android:minWidth="140dp">

    <!-- Current Live FID Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical">



        <TextView
            android:id="@+id/current_fid_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_live_fid"
            android:textStyle="bold"
            android:layout_marginEnd="16dp"
            android:textColor="@color/accent"
            android:textSize="14sp" />
        <ImageView
            android:id="@+id/current_fid_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/current_live_fid"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_light"
        android:layout_marginVertical="4dp" />

    <!-- Main FID -->
    <TextView
        android:id="@+id/menu_main_fid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/main_fid"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- My Master -->
    <TextView
        android:id="@+id/menu_my_master"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/my_master"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- My Watched FIDs -->
    <TextView
        android:id="@+id/menu_my_watched_fids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/my_watched"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- My Multisig FIDs -->
    <TextView
        android:id="@+id/menu_my_multisign_fids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/my_multisig"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- My Servants -->
    <TextView
        android:id="@+id/menu_my_servants"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="@string/my_servants"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_light"
        android:layout_marginVertical="4dp" />

    <!-- Quit Main FID -->
    <LinearLayout
        android:id="@+id/menu_quit_main_fid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/menu_quit_main_fid_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quit_main_fid"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/menu_quit_main_fid_avatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/main_fid"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person" />

    </LinearLayout>

</LinearLayout>