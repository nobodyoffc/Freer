<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_setup_message"
                android:textColor="@color/hint"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- BASE (chain server): first of the home; followed by every device of this FID -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_setup_base_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/server_setup_base_explain"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/base_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_base_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/choose_base_button"
                    style="@style/ImageButtonStyle"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/choose_another" />
            </LinearLayout>

            <!-- Sealed to the FID's own pubkey; only a service id can be (HomePrivacy) -->
            <CheckBox
                android:id="@+id/base_private_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/server_setup_private"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Which server this device reads through, and why the home BASE is not it -->
            <TextView
                android:id="@+id/base_connection_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/base_problem_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/field_name"
                android:textSize="13sp"
                android:textIsSelectable="true"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/follow_base_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/server_setup_follow_base"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- DOCK (messaging) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_setup_dock_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dock_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_dock_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/choose_dock_button"
                    style="@style/ImageButtonStyle"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/choose_another" />
            </LinearLayout>

            <!-- DISK (data) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/server_setup_disk_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/disk_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_disk_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/choose_disk_button"
                    style="@style/ImageButtonStyle"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/choose_another" />
            </LinearLayout>

            <!-- Sealed to the FID's own pubkey; only a service id can be (HomePrivacy) -->
            <CheckBox
                android:id="@+id/disk_private_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/server_setup_private"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- CALL (voice calls): opt-in, VOICE_SPEC §6.2 -->
            <CheckBox
                android:id="@+id/call_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_setup_call_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/server_setup_call_explain"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/call_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/call_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_call_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/choose_call_button"
                    style="@style/ImageButtonStyle"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/choose_another" />
            </LinearLayout>

            <!-- ROAD (instant delivery, with its MAP): opt-in -->
            <CheckBox
                android:id="@+id/road_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_setup_road_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/server_setup_road_explain"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/road_suggest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/server_setup_road_suggest"
                android:textColor="@color/field_name"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/road_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/road_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_road_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <ImageButton
                    android:id="@+id/choose_road_button"
                    style="@style/ImageButtonStyle"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/choose_another" />
            </LinearLayout>

            <!-- FUDP: only for a node with a fixed, reachable address; never set automatically -->
            <CheckBox
                android:id="@+id/fudp_checkbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/server_setup_fudp_label"
                android:textColor="@color/field_name"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/server_setup_fudp_explain"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/fudp_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:boxBackgroundColor="@color/input_field_background"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fudp_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/server_setup_fudp_hint"
                        android:inputType="text"
                        android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/register_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_send"
            android:contentDescription="@string/publish" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
