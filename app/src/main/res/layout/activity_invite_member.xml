<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_fids_to_invite"
            android:textColor="@color/field_name"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/fids_input"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:hint="@string/enter_fids_one_per_line"
            android:background="@drawable/container_outline"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:scrollbars="vertical" />

        <!-- Button Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">



            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/clear_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear_list" />

            <ImageButton
                android:id="@+id/from_list_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_list"
                android:contentDescription="@string/add_from_fid_list" />

            <ImageButton
                android:id="@+id/from_contacts_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_contact"
                android:contentDescription="@string/choose_from_contacts" />

            <ImageButton
                android:id="@+id/search_on_chain_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_fids_on_chain" />

            <ImageButton
                android:id="@+id/invite_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_tick"
                android:contentDescription="@string/invite_members" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
