<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:layout_margin="16dp"
        android:fillViewport="true">

        <!-- Affair Container for structured display -->
        <include
            android:id="@+id/affairContainer"
            layout="@layout/layout_affair_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

    </ScrollView>
    <!-- Result View -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp">
        <include
            android:id="@+id/resultView"
            layout="@layout/layout_text_box_with_make_qr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/clearButton"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/clear" />

        <ImageButton
            android:id="@+id/copyButton"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_copy"
            android:contentDescription="@string/copy" />

        <ImageButton
            android:id="@+id/doButton"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/do_affair" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />
    </LinearLayout>

</LinearLayout>
