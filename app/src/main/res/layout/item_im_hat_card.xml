<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/im_hat_type_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_json"
        app:tint="@color/accent"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/im_hat_card_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textColor="@color/text" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/im_hat_card_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/hint" />

        </LinearLayout>

        <TextView
            android:id="@+id/im_hat_card_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp">

        <ImageButton
            android:id="@+id/im_hat_play_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_play"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/im_hat_download_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/cancel_download"
            app:indicatorSize="30dp"
            app:trackThickness="3dp"
            app:indicatorColor="@color/accent"
            app:trackColor="@color/hint" />

    </FrameLayout>

</LinearLayout>
