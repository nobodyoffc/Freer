<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared "messaging not ready" banner. Injected programmatically below the
  toolbar by BaseCryptoActivity. Shows a Connecting spinner while ImManager is
  being built, or a Retry action if the build failed. The list/chat content
  underneath stays visible so any cached data is never hidden.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/im_not_ready_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:padding="10dp"
    android:background="@drawable/container_outline"
    android:gravity="center_vertical"
    android:visibility="gone">

    <ProgressBar
        android:id="@+id/im_banner_progress"
        android:layout_width="18dp"
        android:layout_height="18dp"
        style="?android:attr/progressBarStyleSmall" />

    <TextView
        android:id="@+id/im_banner_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:text="@string/im_connecting"
        android:textSize="14sp"
        android:textColor="@color/colorAccent" />

    <TextView
        android:id="@+id/im_banner_retry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/retry"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorAccent"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

</LinearLayout>
