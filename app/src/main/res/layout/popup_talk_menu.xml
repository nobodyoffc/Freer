<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="8dp">

    <TextView
        android:id="@+id/menu_setup_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_my_dock"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_privacy_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/p2p_chat_settings"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_manage_blacklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_blacklist"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/menu_newcomer_requests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/newcomer_requests"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
