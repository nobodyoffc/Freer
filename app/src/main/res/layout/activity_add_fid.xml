<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/key_card_background">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FID Search Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Search Results Hint -->
            <TextView
                android:id="@+id/searchResultsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_results"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Search Results ScrollView -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_result_view"
                android:layout_marginBottom="8dp"
                android:padding="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Search Results Layout -->
                    <LinearLayout
                        android:id="@+id/searchResultsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- More Results Section -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/moreResultsHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/hint"
                            android:textSize="12sp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/moreFidButton"
                            style="@style/SmallImageButton"
                            android:src="@drawable/ic_more_down"
                            android:contentDescription="@string/more"/>

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <!-- FID Search Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="0dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/fidSearchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:hint="@string/enter_fid_or_cidt"
                    android:inputType="text"
                    android:textColor="@color/text"
                    android:textColorHint="@color/hint"
                    android:background="@drawable/bg_input_view" />

                <ImageButton
                    android:id="@+id/clearFidButton"
                    android:contentDescription="@string/clear"
                    android:src="@drawable/ic_clear"
                    style="@style/SmallImageButton" />

                <ImageButton
                    android:id="@+id/searchButton"
                    android:contentDescription="@string/search"
                    android:src="@drawable/ic_search"
                    style="@style/SmallImageButton"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Original FID Input Container -->
        <LinearLayout
            android:id="@+id/fidInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <include
                android:id="@+id/fidInput"
                layout="@layout/layout_text_input_with_scan" />

        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear"
                />

            <ImageButton
                android:id="@+id/addButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_tick"
                android:contentDescription="@string/add"
            />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back"
            />

        </LinearLayout>

    </LinearLayout>

</LinearLayout> 