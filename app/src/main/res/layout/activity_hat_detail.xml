<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <EditText
                android:id="@+id/hat_name_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/description"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <EditText
                android:id="@+id/hat_desc_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- ID (read-only) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/id"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_id_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:layout_marginBottom="16dp" />

            <!-- Size -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/size"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_size_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/type"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_type_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Created -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/created"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_born_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Last Accessed -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/last_accessed"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_last_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Locations -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/locations"
                android:textSize="12sp"
                android:textColor="@color/hint" />

            <TextView
                android:id="@+id/hat_locations_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textIsSelectable="true"
                android:layout_marginBottom="16dp" />

            <!-- Encryption Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/hat_encrypt_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hat_encrypt_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/save_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_save"
            android:contentDescription="@string/save" />

        <ImageButton
            android:id="@+id/upload_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_upload"
            android:contentDescription="@string/upload" />

        <ImageButton
            android:id="@+id/download_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/download"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/open_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_play"
            android:contentDescription="@string/open" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
