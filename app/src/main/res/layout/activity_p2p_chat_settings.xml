<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ========== Stranger Policy Section ========== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stranger_policy"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <CheckBox
                android:id="@+id/cb_reject_all_strangers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reject_all_strangers"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/cb_auto_accept_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_accept_contact_strangers"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/link_manage_blacklist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_blacklist"
                android:textColor="@color/colorAccent"
                android:textSize="15sp"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/save_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_tick"
            android:contentDescription="@string/save" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
