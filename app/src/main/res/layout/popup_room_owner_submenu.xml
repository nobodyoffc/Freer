<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="8dp">

    <TextView
        android:id="@+id/submenu_update_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_room"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_add_member"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_member"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_remove_member"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remove_member"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_share_room_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_room_info"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_share_symkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_symkey"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_create_symkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reset_symkey"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

    <TextView
        android:id="@+id/submenu_close_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close_room"
        android:textSize="16sp"
        android:textColor="@color/text"
        android:padding="12dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
