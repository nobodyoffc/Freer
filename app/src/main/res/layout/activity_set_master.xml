<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/key_card_background">

    <!-- Include common toolbar -->
    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Results Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/searchResultsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_results"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_result_view"
                android:padding="8dp">

                <LinearLayout
                    android:id="@+id/searchResultsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

        </LinearLayout>

        <!-- Bottom Section Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <!-- Main FID Display -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/current_fid_label"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/mainFidLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />


            <!-- Master Search Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_master"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/text"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                >

                <EditText
                    android:id="@+id/masterSearchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="4"
                    android:hint="@string/enter_master_fid_or_name"
                    android:inputType="text"
                    android:textColor="@color/text"
                    android:textColorHint="@color/hint"
                    android:maxLines="2"
                    android:ellipsize="middle"
                    android:background="@drawable/bg_input_view"
                    />

                <ImageButton
                    android:id="@+id/searchButton"
                    style="@style/SmallImageButton"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search" />

            </LinearLayout>

            <!-- Button Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/clearButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_clear"
                    android:contentDescription="@string/clear" />


                <ImageButton
                    android:id="@+id/setMasterButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_send"
                    android:contentDescription="@string/confirm" />

                <ImageButton
                    android:id="@+id/back_button"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/back" />

            </LinearLayout>

        </LinearLayout>

        </LinearLayout>

    </LinearLayout>

