<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <include layout="@layout/common_toolbar" />

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FcDate View (4/8) -->
        <include
            android:id="@+id/resultView"
            layout="@layout/layout_text_box_with_make_qr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <CheckBox
            android:id="@+id/toHexCheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/to_hex"
            android:textSize="12sp" />

        <!-- Cipher View (2/8) -->
        <include
            android:id="@+id/cipherView"
            layout="@layout/layout_text_input_with_scan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="8dp" />

        <!-- Key View (1/8) -->
        <include
            android:id="@+id/keyView"
            layout="@layout/layout_key_input_with_people_and_scan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_line_height"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />


        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="end">

            <ImageButton
                android:id="@+id/clearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear" />

            <ImageButton
                android:id="@+id/copyDataButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy" />

            <ImageButton
                android:id="@+id/decryptButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_play"
                android:contentDescription="@string/decrypt" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout> 