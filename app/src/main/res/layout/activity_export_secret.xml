<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FcDate container -->
        <include
            android:id="@+id/resultView"
            layout="@layout/layout_text_box_with_make_qr"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/encrypt_by"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/encrypt_by_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- First Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/encrypt_current_password"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/current_password"/>

                <RadioButton
                    android:id="@+id/encrypt_none"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/don_t_encrypt"/>
            </LinearLayout>

            <!-- Second Row -->
            <RadioButton
                android:id="@+id/encrypt_random_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/random_password"
                android:layout_marginTop="4dp"/>
        </RadioGroup>

        <!-- Button container -->
        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="end">

            <ImageButton
                android:id="@+id/make_qr_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_make_qr"
                android:contentDescription="@string/make_qr" />

            <ImageButton
                android:id="@+id/copy_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/copy" />

            <ImageButton
                android:id="@+id/export_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_export"
                android:contentDescription="@string/export" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout> 