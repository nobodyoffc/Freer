<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp">

    <!-- New indicator dot at top left (must be after CardView to appear on top) -->
    <View
        android:id="@+id/new_indicator"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="start|top"
        android:layout_margin="0dp"
        android:background="@android:color/holo_red_light"
        android:elevation="8dp"
        android:visibility="gone"
        />

<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cash_card_dark_background"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/cash_card_dark_background"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            >

            <CheckBox
                android:id="@+id/news_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:visibility="gone"
                />
            <RadioButton
                android:id="@+id/news_radio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                />

            <ImageView
                android:id="@+id/news_avatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/small_avatar_image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_gravity="center_vertical">

                <!-- Doer FID and Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/news_doer_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textSize="16sp"
                        android:textColor="@color/accent"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackground"
                        android:maxLines="1"
                        android:ellipsize="middle"/>
                    <TextView
                        android:id="@+id/news_act_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:textColor="@color/hint"
                        android:layout_marginEnd="8dp"
                        android:maxLines="1"/>

                    <TextView
                        android:id="@+id/news_object_type_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp"
                        android:textColor="@color/warning"
                        android:maxLines="1"/>

                </LinearLayout>

                <!-- Act and Object Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <!-- Object Name -->
                    <TextView
                        android:id="@+id/news_object_name_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/field_name"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:ellipsize="end"/>

                    <TextView
                        android:id="@+id/news_time_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>



            </LinearLayout>

        </LinearLayout>
        <!-- Object Brief -->
        <TextView
            android:id="@+id/news_object_brief_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/text"
            android:layout_marginTop="2dp"
            android:layout_margin="4dp"
            android:maxLines="2"
            android:ellipsize="end"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>



</FrameLayout>
