<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <!-- Container with outline for token list and controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:padding="4dp"
        android:orientation="vertical"
        android:background="@drawable/container_outline">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/token_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/fragment_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/statistics_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingBottom="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/statistics_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp"
                            android:textColor="@color/hint"
                            android:gravity="start" />

                        <Button
                            android:id="@+id/load_more_button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/more"
                            android:textSize="14sp"
                            android:paddingStart="16dp"
                            android:paddingEnd="4dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:minHeight="0dp"
                            android:layout_marginEnd="8dp"
                            android:textColor="@color/accent"
                            android:background="?android:attr/selectableItemBackground"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Sort Controls and Select All -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/background_light"
            android:paddingTop="8dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="0dp">

            <!-- Name Sort Button -->
            <LinearLayout
                android:id="@+id/name_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/name_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/name"
                    android:textSize="14sp"
                    android:textColor="@color/hint"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/name_sort_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sort_none"
                    app:tint="@color/hint"
                    android:contentDescription="@string/name" />

            </LinearLayout>

            <!-- Deployer Sort Button -->
            <LinearLayout
                android:id="@+id/deployer_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/deployer_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deployer"
                    android:textSize="14sp"
                    android:textColor="@color/hint"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/deployer_sort_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sort_none"
                    app:tint="@color/hint"
                    android:contentDescription="@string/deployer" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/selectAllLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/all"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/select_all_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- Search Controls -->
    <include layout="@layout/layout_search_controls" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/more_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/more" />

        <ImageButton
            android:id="@+id/create_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_plus"
            android:contentDescription="@string/create" />

        <ImageButton
            android:id="@+id/hide_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_visibility_off"
            android:contentDescription="@string/hide" />

        <ImageButton
            android:id="@+id/home_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_home"
            android:contentDescription="@string/home_tokens_mode" />

        <ImageButton
            android:id="@+id/clear_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/clear" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
