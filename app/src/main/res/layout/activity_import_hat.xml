<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/hatJsonInputContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                android:id="@+id/hatJsonInput"
                layout="@layout/layout_text_input_with_scan" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/hatButtonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageButton
                android:id="@+id/hatClearButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/clear" />

            <ImageButton
                android:id="@+id/hatImportButton"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_import"
                android:contentDescription="@string/import_a" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/ImageButtonStyle"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
