<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/key_card_background">

    <include layout="@layout/common_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card Container Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/searchResultsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/search_results"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_result_view"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/searchResultsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/moreResultsHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/hint"
                                android:textSize="12sp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginTop="4dp"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/moreButton"
                                style="@style/SmallImageButton"
                                android:src="@drawable/ic_more_down"
                                android:contentDescription="@string/more" />

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <!-- Tick button overlay in bottom-right corner of the card container -->
            <ImageButton
                android:id="@+id/addToSelectedButton"
                style="@style/SmallImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:src="@drawable/ic_tick"
                android:contentDescription="@string/add_checked_to_selected"
                android:visibility="gone" />

        </FrameLayout>

        <!-- Search bar and action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:padding="4dp"
                android:background="@drawable/container_outline"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/fidSearchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/enter_fid_or_cid"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:textSize="16sp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageView
                    android:id="@+id/clear_search_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_clear"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/clear"
                    android:visibility="gone"
                    app:tint="@color/accent" />

                <ImageView
                    android:id="@+id/search_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_search"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/search"
                    app:tint="@color/accent" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <ImageButton
                    android:id="@+id/clearAllButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_clear"
                    android:contentDescription="@string/clear_all" />

                <ImageButton
                    android:id="@+id/fromListButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_list"
                    android:contentDescription="@string/add_from_fid_list" />

                <ImageButton
                    android:id="@+id/contactButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_contact"
                    android:contentDescription="@string/choose_from_contacts" />

                <ImageButton
                    android:id="@+id/confirmButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_tick"
                    android:contentDescription="@string/confirm"
                    android:enabled="false" />

                <ImageButton
                    android:id="@+id/backButton"
                    style="@style/ImageButtonStyle"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/back" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
