<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <!-- Channel info -->
    <LinearLayout
        android:id="@+id/channel_info_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/channel_info_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/channel_info_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="@color/hint"
            android:gravity="end"
            android:singleLine="true"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Outstanding symkey asks (docs/SYMKEY_IDENTITY_SPEC.md §7): who was asked, and
         how long ago. An ask that shows nothing reads as a request that went nowhere. -->
    <LinearLayout
        android:id="@+id/symkey_ask_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:padding="8dp"
        android:background="@drawable/container_outline"
        android:visibility="gone">

        <TextView
            android:id="@+id/symkey_ask_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/symkey_ask_who"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/symkey_ask_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/symkey_ask_more"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:padding="4dp" />

            <TextView
                android:id="@+id/symkey_ask_give_up"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/symkey_ask_give_up"
                android:textSize="13sp"
                android:textColor="@color/hint"
                android:padding="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Messages container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="2dp"

        android:padding="4dp"
        android:orientation="vertical"
        android:background="@drawable/container_outline">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <!-- Chat type notification -->
    <TextView
        android:id="@+id/chat_type_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="4dp"
        android:textSize="12sp"
        android:gravity="start"
        android:visibility="gone" />

    <!-- Input area -->
    <LinearLayout
        android:id="@+id/input_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp"
        android:layout_marginTop="8dp"
        android:background="@color/background_light"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/attach_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_attach"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/attach"
            app:tint="@color/accent" />

        <ImageButton
            android:id="@+id/emoji_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_emoji"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/emoji"
            app:tint="@color/accent" />

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/type_message"
            android:background="@color/background"
            android:padding="8dp"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageButton
                android:id="@+id/send_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_send"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/send"
                android:visibility="gone"
                app:tint="@color/accent" />

            <ImageButton
                android:id="@+id/mic_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_mic"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/record_voice"
                app:tint="@color/accent" />

        </FrameLayout>

    </LinearLayout>

    <!-- Recording overlay (hidden by default) -->
    <LinearLayout
        android:id="@+id/recording_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@color/background_light"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/recording_indicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_recording_dot"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/recording_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:gravity="center"
            android:text="0:00" />

        <TextView
            android:id="@+id/recording_slide_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/slide_to_cancel"
            android:textColor="@color/hint"
            android:layout_marginEnd="16dp" />

    </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/voice_note_real_voice"
            android:textColor="@color/hint"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Emoji picker panel -->
    <LinearLayout
        android:id="@+id/emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/container_outline">

        <!-- Category tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/text_area_background">

            <LinearLayout
                android:id="@+id/emoji_category_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />

        </HorizontalScrollView>

        <!-- Emoji grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emoji_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="4dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- Bottom action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end">

        <ImageButton
            android:id="@+id/btn_more"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/more" />

        <ImageButton
            android:id="@+id/btn_clear_input"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/clear" />

        <ImageButton
            android:id="@+id/btn_mail"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_mail"
            android:contentDescription="@string/create_mail" />

        <ImageButton
            android:id="@+id/btn_back"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
