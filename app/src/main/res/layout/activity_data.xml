<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/common_toolbar" />

    <!-- Transfer progress bar (hidden by default) -->
    <LinearLayout
        android:id="@+id/transfer_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:background="@drawable/container_outline"
        android:visibility="gone">

        <TextView
            android:id="@+id/transfer_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:textColor="@color/text" />

        <ProgressBar
            android:id="@+id/transfer_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:max="100" />

        <ImageButton
            android:id="@+id/transfer_cancel_button"
            style="@style/SmallImageButton"
            android:src="@drawable/ic_clear"
            android:contentDescription="@string/cancel"
            android:layout_marginStart="4dp" />

    </LinearLayout>

    <!-- Container with outline for data list and controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="8dp"
        android:padding="4dp"
        android:orientation="vertical"
        android:background="@drawable/container_outline">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/data_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/fragment_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingBottom="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:id="@+id/data_statistics_container">

                        <TextView
                            android:id="@+id/data_statistics"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textSize="12sp"
                            android:textColor="@color/hint"
                            android:gravity="start" />

                        <ImageButton
                            android:id="@+id/load_more_button"
                            style="@style/SmallImageButton"
                            android:src="@drawable/ic_more_down"
                            android:contentDescription="@string/more"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Sort Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:background="@color/background_light">

            <!-- Time Sort Button -->
            <LinearLayout
                android:id="@+id/time_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/time_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time"
                    android:textSize="14sp"
                    android:textColor="@color/hint"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/time_sort_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sort_none"
                    android:contentDescription="@string/time" />

            </LinearLayout>

            <!-- Name Sort Button -->
            <LinearLayout
                android:id="@+id/name_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/name_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/name"
                    android:textSize="14sp"
                    android:textColor="@color/hint"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/name_sort_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sort_none"
                    android:contentDescription="@string/name" />

            </LinearLayout>

            <!-- Size Sort Button -->
            <LinearLayout
                android:id="@+id/size_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/size_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/size"
                    android:textSize="14sp"
                    android:textColor="@color/hint"
                    android:layout_marginEnd="4dp" />

                <ImageView
                    android:id="@+id/size_sort_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_sort_none"
                    android:contentDescription="@string/size" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/selectAllLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/all"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/select_all_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="8dp"
        android:padding="4dp"
        android:background="@drawable/container_outline"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/search_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/search_hint"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/clear_search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_clear"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/clear"
            android:visibility="gone"
            app:tint="@color/accent" />

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_search"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/search"
            app:tint="@color/accent" />

    </LinearLayout>

    <!-- Bottom Action Bar (layout aligned with SecretActivity: gravity end, ImageButtonStyle, Back button) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="end"
        android:background="@color/background_light">

        <ImageButton
            android:id="@+id/more_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_more"
            android:contentDescription="@string/more" />

        <ImageButton
            android:id="@+id/delete_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/download_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_download"
            android:contentDescription="@string/download" />

        <ImageButton
            android:id="@+id/upload_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_upload"
            android:contentDescription="@string/upload" />

        <ImageButton
            android:id="@+id/add_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_add"
            android:contentDescription="@string/add" />

        <ImageButton
            android:id="@+id/confirm_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_tick"
            android:contentDescription="@string/ok"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/back_button"
            style="@style/ImageButtonStyle"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back" />

    </LinearLayout>

</LinearLayout>
